// sendr.soy, run by the Sendr project. Not part of a Sendr instance: deploy with
// `bun run deploy:site`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sendr-soy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "sendr.soy", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@sendr.soy"] }],
  // Limits are per Cloudflare location. They cap how much a misused endpoint can send.
  "ratelimits": [
    { "name": "PER_RECIPIENT", "namespace_id": "7301", "simple": { "limit": 3, "period": 60 } },
    { "name": "OVERALL", "namespace_id": "7302", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
