{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "sendr", "migrations_dir": "migrations" }
  ],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "sendr-send" }],
    "consumers": [
      {
        "queue": "sendr-send",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60
      }
    ]
  },
  "vars": {
    // "memory" prints emails to the log instead of sending them, for local development.
    "EMAIL_PROVIDER": "",
    // Delivers login codes until this instance can send its own. Empty to turn off.
    "LOGIN_CODE_RELAY_URL": "https://sendr.soy/api/login-code"
  },
  "observability": { "enabled": true }
}
